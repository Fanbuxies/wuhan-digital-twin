{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "twin-backend",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:PGPASSWORD = [Environment]::GetEnvironmentVariable('PGPASSWORD','User'); mvn.cmd -B -f backend/pom.xml spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "twin-backend-attach",
      "url": "http://localhost:8080",
      "port": 8080
    },
    {
      "name": "twin-frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
