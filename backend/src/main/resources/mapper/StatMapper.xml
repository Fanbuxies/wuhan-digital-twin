<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wuhan.twin.stat.mapper.StatMapper">

    <resultMap id="statOverviewMap" type="com.wuhan.twin.stat.entity.StatOverviewDO">
        <result column="device_total" property="deviceTotal"/>
        <result column="online_count" property="onlineCount"/>
        <result column="alarm_count" property="alarmCount"/>
    </resultMap>

    <!-- 设备两项计数走同一次扫描；告警数用标量子查询，避免与设备表 join 产生行数放大 -->
    <select id="selectOverview" resultMap="statOverviewMap">
        SELECT
            count(*) AS device_total,
            count(*) FILTER (WHERE d.status = 'ONLINE') AS online_count,
            (SELECT count(*) FROM t_alarm AS a WHERE a.status = 'PENDING') AS alarm_count
        FROM t_device AS d
    </select>

</mapper>
